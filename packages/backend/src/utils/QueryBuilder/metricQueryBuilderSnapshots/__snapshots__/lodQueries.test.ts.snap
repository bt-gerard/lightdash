exports[`MetricQueryBuilder snapshot: LOD queries (FORK: LOD) > builds one CTE per distinct surviving-dimension set 1`] = `
"WITH
  lod_base AS (
    SELECT
      "sales".product_name AS "sales_product_name",
      "sales".region AS "sales_region"
    FROM
      "postgres"."jaffle"."sales" AS "sales"
    GROUP BY
      1,
      2
  ),
  lod_1 AS (
    SELECT
      "sales".region AS "sales_region",
      SUM("sales".total_customers) AS "sales_total_customers"
    FROM
      "postgres"."jaffle"."sales" AS "sales"
    GROUP BY
      1
  ),
  lod_2 AS (
    SELECT
      "sales".product_name AS "sales_product_name",
      SUM("sales".total_customers) AS "sales_total_by_product"
    FROM
      "postgres"."jaffle"."sales" AS "sales"
    GROUP BY
      1
  ),
  metrics AS (
    SELECT
      lod_base.*,
      lod_1."sales_total_customers" AS "sales_total_customers",
      lod_2."sales_total_by_product" AS "sales_total_by_product"
    FROM
      lod_base
      LEFT JOIN lod_1 ON (
        lod_base."sales_region" = lod_1."sales_region"
        OR (
          lod_base."sales_region" IS NULL
          AND lod_1."sales_region" IS NULL
        )
      )
      LEFT JOIN lod_2 ON (
        lod_base."sales_product_name" = lod_2."sales_product_name"
        OR (
          lod_base."sales_product_name" IS NULL
          AND lod_2."sales_product_name" IS NULL
        )
      )
  )
SELECT
  *
FROM
  metrics
ORDER BY
  "sales_total_customers" DESC
LIMIT
  500"
`;

