exports[`MetricQueryBuilder snapshot: LOD queries (FORK: LOD) > renders the join inside the LOD CTE on a joined explore 1`] = `
"WITH
  lod_base AS (
    SELECT
      "orders".order_id AS "orders_order_id",
      "customers".country AS "customers_country"
    FROM
      "postgres"."jaffle"."orders" AS "orders"
      LEFT OUTER JOIN "postgres"."jaffle"."customers" AS "customers" ON ("orders".customer_id) = ("customers".customer_id)
    GROUP BY
      1,
      2
  ),
  lod_1 AS (
    SELECT
      "customers".country AS "customers_country",
      SUM("orders".amount) AS "orders_total_amount"
    FROM
      "postgres"."jaffle"."orders" AS "orders"
      LEFT OUTER JOIN "postgres"."jaffle"."customers" AS "customers" ON ("orders".customer_id) = ("customers".customer_id)
    GROUP BY
      1
  ),
  metrics AS (
    SELECT
      lod_base.*,
      lod_1."orders_total_amount" AS "orders_total_amount"
    FROM
      lod_base
      LEFT JOIN lod_1 ON (
        lod_base."customers_country" = lod_1."customers_country"
        OR (
          lod_base."customers_country" IS NULL
          AND lod_1."customers_country" IS NULL
        )
      )
  )
SELECT
  *
FROM
  metrics
ORDER BY
  "orders_total_amount" DESC
LIMIT
  500"
`;

exports[`MetricQueryBuilder snapshot: LOD queries (FORK: LOD) > rewrites derived metric refs to CTE columns 1`] = `
"WITH
  lod_base AS (
    SELECT
      "sales".product_name AS "sales_product_name",
      SUM("sales".customers_purchasing) AS "sales_customers_purchasing"
    FROM
      "postgres"."jaffle"."sales" AS "sales"
    GROUP BY
      1
  ),
  lod_1 AS (
    SELECT
      SUM("sales".total_customers) AS "sales_total_customers"
    FROM
      "postgres"."jaffle"."sales" AS "sales"
  ),
  metrics AS (
    SELECT
      lod_base.*,
      lod_1."sales_total_customers" AS "sales_total_customers",
      (
        lod_base."sales_customers_purchasing" / lod_1."sales_total_customers"
      ) * 100 AS "sales_pct_customers_purchasing"
    FROM
      lod_base
      CROSS JOIN lod_1
  )
SELECT
  *
FROM
  metrics
ORDER BY
  "sales_customers_purchasing" DESC
LIMIT
  500"
`;

