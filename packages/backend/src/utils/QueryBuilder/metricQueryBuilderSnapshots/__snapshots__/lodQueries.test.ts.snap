exports[`MetricQueryBuilder snapshot: LOD queries (FORK: LOD) > lets a table calculation read the LOD metric outer alias 1`] = `
"WITH
  lod_base AS (
    SELECT
      "sales".product_name AS "sales_product_name",
      "sales".region AS "sales_region"
    FROM
      "postgres"."jaffle"."sales" AS "sales"
    GROUP BY
      1,
      2
  ),
  lod_1 AS (
    SELECT
      "sales".region AS "sales_region",
      SUM("sales".total_customers) AS "sales_total_customers"
    FROM
      "postgres"."jaffle"."sales" AS "sales"
    GROUP BY
      1
  ),
  metrics AS (
    SELECT
      lod_base.*,
      lod_1."sales_total_customers" AS "sales_total_customers"
    FROM
      lod_base
      LEFT JOIN lod_1 ON (
        lod_base."sales_region" = lod_1."sales_region"
        OR (
          lod_base."sales_region" IS NULL
          AND lod_1."sales_region" IS NULL
        )
      )
  )
SELECT
  *,
  "sales_total_customers" * 2 AS "double_total"
FROM
  metrics
ORDER BY
  "sales_total_customers" DESC
LIMIT
  500"
`;

exports[`MetricQueryBuilder snapshot: LOD queries (FORK: LOD) > matches all grains of an ignored base time dimension 1`] = `
"WITH
  lod_base AS (
    SELECT
      DATE_TRUNC('MONTH', "sales".order_date) AS "sales_order_date_month",
      "sales".region AS "sales_region"
    FROM
      "postgres"."jaffle"."sales" AS "sales"
    GROUP BY
      1,
      2
  ),
  lod_1 AS (
    SELECT
      "sales".region AS "sales_region",
      SUM("sales".total_customers) AS "sales_customers_ignoring_date"
    FROM
      "postgres"."jaffle"."sales" AS "sales"
    GROUP BY
      1
  ),
  metrics AS (
    SELECT
      lod_base.*,
      lod_1."sales_customers_ignoring_date" AS "sales_customers_ignoring_date"
    FROM
      lod_base
      LEFT JOIN lod_1 ON (
        lod_base."sales_region" = lod_1."sales_region"
        OR (
          lod_base."sales_region" IS NULL
          AND lod_1."sales_region" IS NULL
        )
      )
  )
SELECT
  *
FROM
  metrics
ORDER BY
  "sales_order_date_month" DESC
LIMIT
  500"
`;

