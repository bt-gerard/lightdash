{
    "extends": "./../../tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "target": "ES2020",
        "module": "CommonJS",
        "moduleDetection": "force",
        "lib": ["ES2020", "dom"],
        "types": ["cypress", "@testing-library/cypress", "node"],
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "isolatedModules": true
    },
    "include": ["**/*.ts"]
}
